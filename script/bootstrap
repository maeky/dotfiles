#!/bin/bash
# Link only an explicit, reviewed set of configuration files.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"
mode=dry-run
case "${1:---dry-run}" in
  --dry-run) ;;
  --apply) mode=apply ;;
  *) echo "Usage: $0 [--dry-run|--apply]" >&2; exit 2 ;;
esac
if [ "$#" -gt 1 ]; then
  echo "Usage: $0 [--dry-run|--apply]" >&2; exit 2
fi
if [ -z "${HOME:-}" ] || [ "$HOME" = / ]; then
  echo "HOME must point to a user home directory." >&2; exit 2
fi

sources=(
  zsh/zshrc.symlink
  git/gitconfig.symlink
  git/gitignore.symlink
  mise/config.toml
  ghostty/config
  herdr/config.toml
)

targets=(
  "$HOME/.zshrc"
  "$HOME/.gitconfig"
  "$HOME/.gitignore"
  "$HOME/.config/mise/config.toml"
  "$HOME/.config/ghostty/config"
  "$HOME/.config/herdr/config.toml"
)

conflicts=0
for i in "${!sources[@]}"; do
  src="$ROOT/${sources[$i]}"
  dst="${targets[$i]}"
  if [ ! -f "$src" ]; then
    echo "Missing source: $src" >&2; conflicts=1
  elif [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]; then
    echo "Already linked: $dst"
  elif [ -e "$dst" ] || [ -L "$dst" ]; then
    echo "Conflict: $dst (preserve it and resolve manually)" >&2; conflicts=1
  else
    echo "Link: $dst -> $src"
  fi
done
if [ "$conflicts" -ne 0 ]; then
  echo "No links created: resolve all conflicts first." >&2; exit 1
fi
if [ "$mode" = dry-run ]; then
  echo "Preview only. Use --apply to create these links. No software is installed."
  exit 0
fi
for i in "${!sources[@]}"; do
  src="$ROOT/${sources[$i]}"
  dst="${targets[$i]}"
  if [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]; then continue; fi
  mkdir -p "$(dirname "$dst")"
  ln -s "$src" "$dst"
done
echo "Links created. Open a new terminal when you are ready to activate Zsh configuration."
