#!/bin/sh
# Informational only: installation is a separate, explicit action.
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)"
printf 'Review %s/Brewfile, then install explicitly with:\n' "$ROOT"
printf '  /opt/homebrew/bin/brew bundle --file="%s/Brewfile"\n' "$ROOT"
printf 'No packages or system settings have been changed.\n'
