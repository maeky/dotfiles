# Explicit startup list; no recursive sourcing or private-file auto-loading.
export ZSH="$HOME/.dotfiles"
export PROJECTS="$HOME/Projects"
typeset -U path fpath
source "$ZSH/homebrew/path.zsh"
source "$ZSH/system/_path.zsh"
source "$ZSH/system/env.zsh"
source "$ZSH/zsh/config.zsh"
source "$ZSH/zsh/aliases.zsh"

autoload -Uz compinit
compinit
source "$ZSH/zsh/completion.zsh"

if [[ -r /opt/homebrew/share/powerlevel10k/powerlevel10k.zsh-theme ]]; then
  source /opt/homebrew/share/powerlevel10k/powerlevel10k.zsh-theme
  source "$ZSH/powerlevel10k/p10k.zsh"
fi

# Execute initialization only from the known Homebrew installation.
if [[ -x /opt/homebrew/bin/mise ]]; then
  eval "$(/opt/homebrew/bin/mise activate zsh)"
fi

# Lets ssh-add use the same agent as the SSH config template.
export SSH_AUTH_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
